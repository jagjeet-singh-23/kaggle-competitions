# Competition data is never committed. It is large (33 GB across the three) and
# redistributing it breaks the competition rules and the dataset licences
# (LANL: competition rules; BirdCLEF: CC BY-NC-SA 4.0; Enveda: CC BY-NC 4.0).
# Run ./fetch_data.sh to pull it from Kaggle after accepting each competition's rules.
data/

# Derived caches and outputs
*.npy
*.parquet
*.zip
submission.csv

# Credentials — never commit; the scripts read ~/.kaggle/kaggle.json at runtime
kaggle.json
.env

# Pretrained weights: BirdNET V2.4 (MIT, kahst/BirdNET-Analyzer). 214 MB.
# See BirdCLEF/GUIDE.md for the download URL.
models/

__pycache__/
*.pyc
.ipynb_checkpoints/
.gstack/

# Kernel code staging: copies of the modules, uploaded to Kaggle as a dataset so the
# notebook imports one copy instead of pasting the source in. Regenerate with:
#   cp metric.py library.py search.py analog.py kernel/code/
MoleculeID-from-Mass-Spectra/kernel/code/

# Kernel staging: copies of modules + the BirdNET weights and pip wheels, uploaded to
# Kaggle as datasets so the notebooks import one copy and install offline.
BirdCLEF/kernel/code/
BirdCLEF/kernel/wheels/
MoleculeID-from-Mass-Spectra/kernel/wheels/

# Candidate-pool shards staged for upload as Kaggle datasets. COCONUT is 260 MB and
# PubChem is several GB; both are rebuildable from external.py / pubchem.py.
MoleculeID-from-Mass-Spectra/kernel/extdb/
MoleculeID-from-Mass-Spectra/kernel/pubchemdb/

# Staged copy for `kaggle kernels push`; the source is kernel/pubchem_build.py.
MoleculeID-from-Mass-Spectra/kernel/build/pubchem_build.py
